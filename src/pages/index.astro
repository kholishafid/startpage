---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="grid">
      <section class="tile clock" aria-label="Clock">
        <div class="small" id="greet">
          Good morning
        </div>
        <div>
          <div class="time" id="time">
            --<span>:</span>--
          </div>
          <div class="date" id="date"></div>
        </div>
      </section>

      <section class="tile hero">
        <img
          src="https://images.unsplash.com/photo-1621157281949-65e2de4ba88b?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
          style="position: absolute;inset: 0;width: 100%;height: 100%;"
          alt=""
        />
        <div class="txt">
          <div class="bar"></div>
          <h1 id="headline">
            Good morning.
            <br />
            <span>What are you looking for?</span>
          </h1>
          <p>Search the web or type an address.</p>
        </div>
        <form class="search" id="sf" role="search">
          <input
            id="q"
            type="text"
            placeholder="Search or enter address"
            autocomplete="off"
            autofocus
            aria-label="Search"
            list="sf-list"
          />
          <div class="search-suggestion-container" id="search-suggestion-container">
            <ul class="search-suggestion-list" id="search-suggestion-list">
              <li class="search-suggestion-item">Github</li>
              <li class="search-suggestion-item">Instagram</li>
              <li class="search-suggestion-item">Facebook</li>
            </ul>
          </div>

          <button type="submit">Search</button>
        </form>
      </section>

      <section class="tile stats" aria-label="Progress">
        <div class="stat">
          <b id="dayp">0%</b>
          <span>of today gone</span>
          <div class="meter">
            <i id="daym"></i>
          </div>
        </div>
        <div class="stat">
          <b id="yearp">0%</b>
          <span>of the year gone</span>
          <div class="meter">
            <i id="yearm"></i>
          </div>
        </div>
      </section>

      <section class="tile focus">
        <div class="top">
          <span>Today</span>
          <span id="wk"></span>
        </div>
        <label for="focus">My focus today</label>
        <input
          id="focus"
          type="text"
          placeholder="Write one thing"
          maxlength="60"
        />
      </section>

      <nav class="tile links" aria-label="Shortcuts">
        <div class="head">
          <b>Shortcuts</b>
          <span>Open in this tab</span>
        </div>
        <ul>
          <li>
            <a href="https://mail.google.com">
              <i style="background: #d64b3c">M</i>Mail
            </a>
          </li>
          <li>
            <a href="https://calendar.google.com">
              <i style="background: #3a78e0">C</i>Calendar
            </a>
          </li>
          <li>
            <a href="https://drive.google.com">
              <i style="background: #2f9e5b">D</i>Drive
            </a>
          </li>
          <li>
            <a href="https://github.com">
              <i style="background: #22252b">G</i>GitHub
            </a>
          </li>
        </ul>
      </nav>

      <section class="tile weather" aria-label="Current weather">
        <div class="weather-head">
          <div class="weather-location" id="weather-location">Your location</div>
          <button class="weather-refresh" id="weather-refresh" type="button" aria-label="Refresh weather">
            Refresh
          </button>
        </div>

        <div class="weather-main">
          <div>
            <div class="weather-temperature" id="weather-temperature">--°</div>
            <div class="weather-condition" id="weather-condition">Getting weather...</div>
          </div>
          <img
            class="weather-icon"
            id="weather-icon"
            src="/weather_icons/icons8-sun-48.png"
            alt=""
          />
        </div>
      </section>

      <section class="tile notes">
        <div class="small">Quick note</div>
        <textarea
          id="note"
          placeholder="Jot something down. It stays in this browser."
          aria-label="Quick note"
        ></textarea>
      </section>
    </main>

    <script is:inline>
      const $ = (id) => document.getElementById(id),
        pad = (n) => String(n).padStart(2, "0");
      const store = {
        get(k) {
          try {
            return localStorage.getItem(k) || "";
          } catch (e) {
            return "";
          }
        },
        set(k, v) {
          try {
            localStorage.setItem(k, v);
          } catch (e) {}
        },
      };
      function tick() {
        const d = new Date(),
          h = d.getHours();
        $("time").innerHTML = pad(h) + "<span>:</span>" + pad(d.getMinutes());
        $("date").textContent = d.toLocaleDateString(undefined, {
          weekday: "long",
          month: "long",
          day: "numeric",
        });
        const g =
          h < 5
            ? "Good night"
            : h < 12
              ? "Good morning"
              : h < 18
                ? "Good afternoon"
                : "Good evening";
        $("greet").textContent = g;
        $("headline").innerHTML =
          g + ".<br><span>What are you looking for?</span>";
        const dp = Math.round((h * 60 + d.getMinutes()) / 14.4);
        $("dayp").textContent = dp + "%";
        $("daym").style.width = dp + "%";
        const y = d.getFullYear(),
          yp = Math.round(
            ((d - new Date(y, 0, 1)) /
              (new Date(y + 1, 0, 1) - new Date(y, 0, 1))) *
              100,
          );
        $("yearp").textContent = yp + "%";
        $("yearm").style.width = yp + "%";
        const wk = Math.ceil(
          ((d - new Date(y, 0, 1)) / 864e5 + new Date(y, 0, 1).getDay() + 1) /
            7,
        );
        $("wk").textContent = "Week " + wk;
      }
      tick();
      setInterval(tick, 15000);
      $("sf").addEventListener("submit", (e) => {
        e.preventDefault();
        const v = $("q").value.trim();
        if (!v) return;
        if (/^https?:\/\//i.test(v)) location.href = v;
        else if (/^[^\s]+\.[a-z]{2,}(\/\S*)?$/i.test(v))
          location.href = "https://" + v;
        else
          location.href =
            "https://www.google.com/search?q=" + encodeURIComponent(v);
      });
      ["focus", "note"].forEach((id) => {
        const el = $(id);
        el.value = store.get(id);
        el.addEventListener("input", () => store.set(id, el.value));
      });
      const weatherDescriptions = {
        0: ["Clear sky", "icons8-sun-48.png"],
        1: ["Mainly clear", "icons8-partly-cloudy-day-48.png"],
        2: ["Partly cloudy", "icons8-partly-cloudy-day-48.png"],
        3: ["Overcast", "icons8-clouds-48.png"],
        45: ["Foggy", "icons8-haze-48.png"],
        48: ["Rime fog", "icons8-haze-48.png"],
        51: ["Light drizzle", "icons8-light-rain-48.png"],
        53: ["Drizzle", "icons8-rain-48.png"],
        55: ["Heavy drizzle", "icons8-heavy-rain-48.png"],
        61: ["Light rain", "icons8-light-rain-48.png"],
        63: ["Rain", "icons8-moderate-rain-48.png"],
        65: ["Heavy rain", "icons8-heavy-rain-48.png"],
        71: ["Light snow", "icons8-light-snow-48.png"],
        73: ["Snow", "icons8-snow-48.png"],
        75: ["Heavy snow", "icons8-snow-storm-48.png"],
        80: ["Rain showers", "icons8-rainfall-48.png"],
        81: ["Rain showers", "icons8-torrential-rain-48.png"],
        82: ["Heavy showers", "icons8-torrential-rain-48.png"],
        95: ["Thunderstorm", "icons8-storm-48.png"],
        96: ["Thunderstorm with hail", "icons8-storm-with-heavy-rain-48.png"],
        99: ["Thunderstorm with hail", "icons8-storm-with-heavy-rain-48.png"],
      };

      function setWeatherMessage(message) {
        $("weather-condition").textContent = message;
        $("weather-refresh").textContent = "Try again";
      }

      async function loadWeather() {
        $("weather-refresh").disabled = true;
        $("weather-refresh").textContent = "Locating...";
        if (!navigator.geolocation) {
          setWeatherMessage("Location is not supported");
          $("weather-refresh").disabled = false;
          return;
        }

        navigator.geolocation.getCurrentPosition(
          async ({ coords }) => {
            try {
              const params = new URLSearchParams({
                latitude: coords.latitude,
                longitude: coords.longitude,
                current: "temperature_2m,weather_code",
                timezone: "auto",
              });
              const response = await fetch(
                `https://api.open-meteo.com/v1/forecast?${params}`,
              );
              if (!response.ok) throw new Error(`HTTP ${response.status}`);
              const data = await response.json();
              const current = data.current;
              const [condition, icon] = weatherDescriptions[current.weather_code] || [
                "Unknown",
                "icons8-windy-weather-48.png",
              ];
              let location = "Your location";
              try {
                const locationResponse = await fetch(
                  `https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${coords.latitude}&longitude=${coords.longitude}&localityLanguage=en`,
                );
                if (locationResponse.ok) {
                  const locationData = await locationResponse.json();
                  location =
                    locationData.city ||
                    locationData.locality ||
                    locationData.principalSubdivision ||
                    location;
                }
              } catch (error) {
                console.error("Location lookup failed:", error);
              }
              $("weather-location").textContent = location;
              $("weather-icon").src = `/weather_icons/${icon}`;
              $("weather-icon").alt = condition;
              $("weather-temperature").textContent =
                `${Math.round(current.temperature_2m)}°`;
              $("weather-condition").textContent = condition;
              $("weather-refresh").textContent = "Refresh";
            } catch (error) {
              console.error("Weather fetch failed:", error);
              setWeatherMessage("Weather unavailable");
            } finally {
              $("weather-refresh").disabled = false;
            }
          },
          () => {
            setWeatherMessage("Location access needed");
            $("weather-refresh").disabled = false;
          },
          { enableHighAccuracy: false, timeout: 10000, maximumAge: 900000 },
        );
      }

      $("weather-refresh").addEventListener("click", loadWeather);
      loadWeather();

      function debounce(func, wait) {
        let timeout;
        return function (...args) {
          clearTimeout(timeout);
          timeout = setTimeout(() => func.apply(this, args), wait);
        };
      }

      const input = $("q");
      const container = $("search-suggestion-container")
      const suggestionList = $("search-suggestion-list");
      let controller = null;

      async function fetchSuggestions(query) {
        // cancel any in-flight request
        if (controller) controller.abort();

        // don't fetch for empty input
        if (!query) {
          suggestionList.innerHTML = "";
          container.style.display = "none";
          return;
        }

        controller = new AbortController();

        try {
          const res = await fetch(
            `https://suggest-json.itsmaehere.workers.dev?q=${encodeURIComponent(query)}`,
            { signal: controller.signal },
          );
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();

          const suggestions = data.suggestions.map((item) => item.text);

          suggestionList.innerHTML = "";
          suggestions.forEach((suggestion) => {
            const li = document.createElement("li");
            li.className = "search-suggestion-item";
            li.textContent = suggestion;
            li.addEventListener('click', () => {
              input.value = suggestion
            })
            suggestionList.appendChild(li);
          });
          container.style.display = "block";

        } catch (err) {
          if (err.name === "AbortError") return; // expected when superseded
          console.error("Suggestion fetch failed:", err);
        }
      }

      const debouncedFetch = debounce(fetchSuggestions, 300);

      input.addEventListener("input", (e) => {
        debouncedFetch(e.target.value.trim().toLowerCase());
      });
    </script>
  </body>
</html>
